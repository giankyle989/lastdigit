# Docker Postgres password (docker-compose.yml); must match the password in DATABASE_URL
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lastdigit"
# generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
BALLDONTLIE_API_KEY=""
CRON_SECRET=""
# in-app game sync + auto-settle every N minutes (1–1440); unset or 0 = off
SYNC_INTERVAL_MINUTES="5"
# new accounts allowed per client IP per hour (default 5)
SIGNUP_LIMIT_PER_HOUR="5"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
